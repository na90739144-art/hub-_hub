# Hub Hub backend - example environment variables
# On Render: set these in the service's "Environment" tab. NEVER commit real values.

# Groq API key (get a NEW one from console.groq.com/keys)
GROQ_API_KEY=

# The website allowed to call this backend (no trailing slash, no path)
ALLOWED_ORIGIN=https://YOUR-GITHUB-USERNAME.github.io

# Optional: model name (default: openai/gpt-oss-20b)
GROQ_MODEL=
